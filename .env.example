# Names manifest: every variable the app reads, with no secret values. Real values
# come from Infisical (project "music-app-example"): env dev for local runs, env prod for
# Railway. Local run:
#   infisical run --env=dev --path=/backend -- docker compose up -d --build
# Not listed: tuning knobs with code defaults (PROVIDER_THROTTLE_SCALE,
# ENRICH_TIMEOUT_S, ENRICH_SEARCH_BACKENDS) and test/eval switches
# (TEST_DATABASE_URL, ENRICH_LIVE_EVALS). Railway injects PORT.

# /backend: compose + backend runtime. Secrets: DB_PASSWORD, OPENROUTER_API_KEY,
# YOUTUBE_API_KEY, GENIUS_ACCESS_TOKEN. The rest is config.
DB_HOST=db
DB_PORT=5432
DB_NAME=music_app
DB_USER=music
# Secret, no default on purpose. Infisical dev /backend supplies it.
DB_PASSWORD=
API_PORT=8000
AGENTOS_ENABLED=false
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
OWNER_ID=owner
OPENROUTER_API_KEY=
YOUTUBE_API_KEY=
GENIUS_ACCESS_TOKEN=
SECOND_VOICE_MODEL_ID=

# Railway service variable, not in Infisical. When set, DATABASE_URL overrides the
# DB_* variables (backend/db.py load_db_config). Keep it out of Infisical: if it is
# a Railway reference, copying its resolved value would freeze it into a literal.

# /frontend: PUBLIC_* only, inlined into the client bundle at build time. Not secret.
# Railway frontend service variable. Unset, the frontend code falls back to localhost.
PUBLIC_API_URL=http://localhost:8000

# /infra/auth0: Terraform only (specs/007 T005, not scaffolded yet). The app never
# reads these. AUTH0_CLIENT_* is the terraform-deployer M2M client (session-contract.md).
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
TF_VAR_resend_smtp_password=
TF_STATE_PG_CONN_STR=
