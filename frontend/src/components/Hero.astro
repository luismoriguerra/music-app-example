---
/**
 * Static welcoming hero (contracts/components.md): eyebrow + display
 * headline + subcopy with an optional CSS-only stage art wash. Zero JS.
 */
interface Props {
  eyebrow: string;
  title: string;
  subcopy: string;
  art?: "stage" | "none";
}

const { eyebrow, title, subcopy, art = "stage" } = Astro.props;
---

<section
  data-testid="hero"
  class:list={[
    "rock-reserve-hero overflow-hidden rounded-2xl border px-6 py-10 sm:px-10 sm:py-14",
    art === "stage" ? "rock-stage bg-card" : "bg-card",
  ]}
>
  <p class="text-rock text-xs font-semibold uppercase tracking-[0.2em]">
    {eyebrow}
  </p>
  <h1 class="font-display mt-3 text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">
    {title}
  </h1>
  <p class="text-muted-foreground mt-4 max-w-[60ch] text-base sm:text-lg">
    {subcopy}
  </p>
</section>
