---
/**
 * Static ukulele-appropriate course visual (FR-004): inline SVG mark,
 * zero requests. `title` feeds the accessible label.
 */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<span
  role="img"
  aria-label={title}
  data-testid="ukulele-badge"
  class="bg-rock/10 text-rock flex size-12 shrink-0 items-center justify-center rounded-lg"
>
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="size-7"
  >
    <ellipse cx="9" cy="15.5" rx="5.5" ry="4.5"></ellipse>
    <circle cx="9" cy="15.5" r="1.4" fill="currentColor" stroke="none"></circle>
    <path d="M12.5 12.5 17 5"></path>
    <path d="M15.2 3.6 18.4 5.2 17.2 8 14 6.4Z"></path>
    <path d="M13.6 10.6l1.8.9M12.6 12.2l1.8.9"></path>
  </svg>
</span>
