---
import UkuleleBadge from "@/components/UkuleleBadge.astro";

interface Props {
  title: string;
  slug: string;
  description: string;
  cover?: string;
}

const { title, slug, description, cover } = Astro.props;
const href = `/courses/${slug}`;
---

<article
  data-testid="course-card"
  class="rock-reserve-card bg-card text-card-foreground relative flex h-full flex-col gap-3 overflow-hidden rounded-xl border p-5 shadow-sm transition-shadow hover:shadow-md has-[a:focus-visible]:ring-2 has-[a:focus-visible]:ring-rock has-[a:focus-visible]:ring-offset-2 has-[a:focus-visible]:ring-offset-background"
>
  <span aria-hidden="true" class="bg-rock absolute inset-x-0 top-0 h-1"></span>
  <div class="flex items-start gap-3">
    {cover === "ukulele" ? (
      <UkuleleBadge title={title} />
    ) : (
      <div
        aria-hidden="true"
        class="bg-muted flex size-12 shrink-0 items-center justify-center rounded-lg text-2xl"
      >
        {cover ?? title.charAt(0)}
      </div>
    )}
    <div class="min-w-0">
      <h2 class="text-lg font-semibold leading-tight">{title}</h2>
      <p class="text-muted-foreground mt-1 text-sm">{description}</p>
    </div>
  </div>
  <span class="bg-primary text-primary-foreground mt-auto inline-flex min-h-11 items-center justify-center rounded-md px-4 text-sm font-medium">
    <a
      href={href}
      data-astro-prefetch="viewport"
      aria-label={`Open ${title} course`}
      class="after:absolute after:inset-0 focus-visible:outline-none"
    >
      Open course
    </a>
  </span>
</article>
